From a51ea09f3271b9a0ae1fc36684d45183b87e6dff Mon Sep 17 00:00:00 2001
From: ax <ax@initrd.net>
Date: Mon, 28 Sep 2026 14:18:50 +0200
Subject: [PATCH 2/2] fosphor/cl: Fall back to a host side fill if
 clEnqueueFillImage fails

PoCL accepts CL_RGBA / CL_FLOAT images but still rejects
clEnqueueFillImage() on them with CL_IMAGE_FORMAT_NOT_SUPPORTED, which
leaves fosphor stuck in CL_BOOTING retrying the clear forever.

Fall back to filling a host side buffer and uploading it with
clEnqueueWriteImage(). The buffers are only ever cleared during init so
the extra copy doesn't matter.

Signed-off-by: ax <ax@initrd.net>
---
 lib/fosphor/cl.c | 64 +++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 52 insertions(+), 12 deletions(-)

diff --git a/lib/fosphor/cl.c b/lib/fosphor/cl.c
index a3cd4a5..7d46d8a 100644
--- a/lib/fosphor/cl.c
+++ b/lib/fosphor/cl.c
@@ -403,6 +403,54 @@ error:
 	return NULL;
 }
 
+/* Not every implementation that accepts a given image format also
+ * implements clEnqueueFillImage() for it (PoCL rejects the fill with
+ * CL_IMAGE_FORMAT_NOT_SUPPORTED for formats it otherwise supports). Since
+ * this is only used during init, just fall back to filling a host side
+ * buffer and uploading that. */
+static cl_int
+cl_fill_image(struct fosphor *self, cl_mem img, const float *color,
+              const size_t *origin, const size_t *region)
+{
+	struct fosphor_cl_state *cl = self->cl;
+	cl_image_format fmt;
+	size_t i, n_pix, stride;
+	float *buf;
+	cl_int err;
+
+	/* Fast path */
+	err = clEnqueueFillImage(cl->cq, img, color, origin, region,
+	                         0, NULL, NULL);
+	if (err == CL_SUCCESS)
+		return CL_SUCCESS;
+
+	fprintf(stderr, "[w] clEnqueueFillImage failed (%d), "
+	                "falling back to host side fill\n", err);
+
+	/* Slow path */
+	err = clGetImageInfo(img, CL_IMAGE_FORMAT, sizeof(fmt), &fmt, NULL);
+	if (err != CL_SUCCESS)
+		return err;
+
+	stride = (fmt.image_channel_order == CL_R) ? 1 : 4;
+	n_pix  = region[0] * region[1] * region[2];
+
+	buf = malloc(n_pix * stride * sizeof(float));
+	if (!buf)
+		return CL_OUT_OF_HOST_MEMORY;
+
+	for (i=0; i<n_pix; i++)
+		memcpy(&buf[i * stride], color, stride * sizeof(float));
+
+	err = clEnqueueWriteImage(cl->cq, img, CL_TRUE, origin, region,
+	                          0, 0, buf, 0, NULL, NULL);
+
+	free(buf);
+
+	return err;
+}
+
+
 static cl_int
 cl_queue_clear_buffers(struct fosphor *self)
 {
@@ -431,12 +479,8 @@ cl_queue_clear_buffers(struct fosphor *self)
 	img_region[1] = 1024;
 	img_region[2] = 1;
 
-	err = clEnqueueFillImage(cl->cq,
-		cl->mem_waterfall,
-		color,
-		img_origin, img_region,
-		0, NULL, NULL
-	);
+	err = cl_fill_image(self, cl->mem_waterfall, color,
+	                    img_origin, img_region);
 	CL_ERR_CHECK(err, "Unable to queue clear of waterfall image");
 
 	/* Init the histogram image to all 0.0f values */
@@ -446,12 +490,8 @@ cl_queue_clear_buffers(struct fosphor *self)
 	img_region[1] = 128;
 	img_region[2] = 1;
 
-	err = clEnqueueFillImage(cl->cq,
-		cl->mem_histogram,
-		color,
-		img_origin, img_region,
-		0, NULL, NULL
-	);
+	err = cl_fill_image(self, cl->mem_histogram, color,
+	                    img_origin, img_region);
 	CL_ERR_CHECK(err, "Unable to queue clear of histogram image");
 
 	/* Need to finish because our patterns are on the stack */
